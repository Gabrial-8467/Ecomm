# ---------------------------------------------------------------------------
# CasaCircuit environment template
# Copy to .env (development) or configure in your secret manager (production).
# NEVER commit .env or real secrets.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=CasaCircuit
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
SUPPORT_EMAIL=support@example.invalid

# Database (PostgreSQL 18). Use TLS in managed environments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casacircuit
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casacircuit
# Used only by `prisma migrate dev` for shadow databases.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/casacircuit_shadow

# Redis (required in production; optional in development)
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=casacircuit
# Set to false only for local development without Redis. Production validation rejects false.
REDIS_REQUIRED=true

# Sessions / security
SESSION_COOKIE_NAME=cc_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
OTP_PEPPER=replace-with-at-least-32-random-bytes
MFA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Comma-separated trusted origins for state-changing requests (production)
TRUSTED_ORIGINS=http://localhost:3000

# Admin bootstrap (development only; never use in production)
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Operations Admin

# Razorpay (Phase 8)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Email (Resend or compatible)
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="CasaCircuit <orders@example.invalid>"

# SMS / OTP (interchangeable adapter: console, msg91, twilio)
SMS_PROVIDER=console
SMS_SENDER_ID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Storage (s3 | cloudinary | local)
STORAGE_PROVIDER=local
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_HOSTNAME=

# Shipping (Phase 9)
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_SECRET=
DELHIVERY_API_KEY=
DELHIVERY_WEBHOOK_SECRET=

# Observability
LOG_LEVEL=info
LOG_FORMAT=pretty
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Business rules (safe defaults; override per environment)
CART_MAX_QUANTITY_PER_LINE=10
RESERVATION_TTL_MINUTES=15
COD_MAX_ORDER_VALUE=50000
FREE_SHIPPING_THRESHOLD=4999
DEFAULT_RETURN_WINDOW_DAYS=7
ADMIN_MFA_REQUIRED=true
