// ---------------------------------------------------------------------------
// Identity, access, seller
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(cuid())
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?
  firstName        String?
  lastName         String?
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt  DateTime?  @db.Timestamptz(3)
  phoneVerifiedAt  DateTime?  @db.Timestamptz(3)
  marketingOptIn   Boolean    @default(false)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  deletedAt        DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  customerProfile    CustomerProfile?
  adminProfile       AdminProfile?
  sessions           Session[]
  addresses          Address[]
  userRoles          UserRole[]
  verificationTokens VerificationToken[]
  mfaCredential      MfaCredential?
  carts              Cart[]
  orders             Order[]
  returnRequests     ReturnRequest[]
  couponUsages       CouponUsage[]
  wishlist           Wishlist?
  comparisons        Comparison[]
  reviews            Review[]
  reviewVotes        ReviewVote[]
  productQuestions   ProductQuestion[]
  productAnswers     ProductAnswer[]
  supportTickets     SupportTicket[]
  grievances         Grievance[]
  privacyRequests    PrivacyRequest[]
  consentRecords     ConsentRecord[]
  policyAcceptances  UserPolicyAcceptance[]
  notifications      Notification[]
  newsletter         NewsletterSubscriber?

  @@index([status])
  @@index([createdAt])
}

model CustomerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  dateOfBirth       DateTime? @db.Date
  gender            String?
  preferredLanguage String    @default("en-IN")
  riskFlags         Json?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  employeeId           String?   @unique
  department           String?
  designation          String?
  isMfaRequired        Boolean   @default(true)
  lastPasswordChangeAt DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Seller {
  id                          String       @id @default(cuid())
  legalName                   String
  displayName                 String
  entityType                  String?
  gstin                       String?
  pan                         String?
  cin                         String?
  status                      SellerStatus @default(ACTIVE)
  isPlatformOwner             Boolean      @default(true)
  registeredAddress           Json?
  principalAddress            Json?
  customerCareEmail           String?
  customerCarePhone           String?
  grievanceOfficerName        String?
  grievanceOfficerDesignation String?
  grievanceOfficerEmail       String?
  grievanceOfficerPhone       String?
  grievanceOfficerAddress     String?
  createdAt                   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime     @updatedAt @db.Timestamptz(3)

  products Product[]
  orders   Order[]

  @@index([status])
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  group       String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([group])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  csrfTokenHash String
  userId        String
  ip            String?
  userAgent     String?
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  rotatedFromId String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Address {
  id                String      @id @default(cuid())
  userId            String
  label             String?
  type              AddressType @default(BOTH)
  fullName          String
  phone             String
  email             String?
  line1             String
  line2             String?
  landmark          String?
  city              String
  state             String
  pincode           String
  country           String      @default("IN")
  isDefaultShipping Boolean     @default(false)
  isDefaultBilling  Boolean     @default(false)
  deletedAt         DateTime?   @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
  @@index([pincode])
}

model VerificationToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  type        TokenType
  userId      String?
  identifier  String?
  codeHash    String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime  @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, identifier, expiresAt])
  @@index([userId, type])
}

model MfaCredential {
  id                String    @id @default(cuid())
  userId            String    @unique
  type              MfaType   @default(TOTP)
  secretEncrypted   String
  backupCodesHashed Json
  enabledAt         DateTime? @db.Timestamptz(3)
  lastUsedAt        DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  parentId           String?
  path               String        @unique
  level              Int           @default(0)
  description        String?
  imageUrl           String?
  icon               String?
  isActive           Boolean       @default(true)
  sortOrder          Int           @default(0)
  seoTitle           String?
  seoDescription     String?
  returnWindowDays   Int           @default(7)
  isReturnable       Boolean       @default(true)
  replacementAllowed Boolean       @default(true)
  warrantyMonths     Int?
  shippingClass      ShippingClass @default(STANDARD)
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  archivedAt         DateTime?     @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products            Product[]
  categoryAttributes  CategoryAttribute[]
  coupons             Coupon[]
  promotionCategories PromotionCategory[]
  navigationItems     NavigationItem[]

  @@index([parentId, sortOrder])
  @@index([isActive, level])
}

model Brand {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  description    String?
  isFeatured     Boolean  @default(false)
  isActive       Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  products        Product[]
  coupons         Coupon[]
  promotionBrands PromotionBrand[]

  @@index([isActive, isFeatured])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  baseSku          String        @unique
  categoryId       String
  brandId          String?
  sellerId         String
  shortDescription String?
  description      String?
  status           ProductStatus @default(DRAFT)
  publishedAt      DateTime?     @db.Timestamptz(3)
  archivedAt       DateTime?     @db.Timestamptz(3)

  // Tax & legal declarations
  hsnCode             String?
  gstRate             Decimal  @default(18) @db.Decimal(5, 2)
  priceIncludesTax    Boolean  @default(true)
  countryOfOrigin     String   @default("IN")
  manufacturerName    String?
  manufacturerAddress String?
  packerName          String?
  importerName        String?
  netQuantity         Decimal? @db.Decimal(12, 3)
  unitOfMeasure       String?
  unitSalePrice       Decimal? @db.Decimal(14, 2)
  consumerCareEmail   String?
  consumerCarePhone   String?
  bisRegistrationNo   String?

  // Commercial policy
  warrantyMonths       Int?
  warrantyType         WarrantyType  @default(NONE)
  isReturnable         Boolean       @default(true)
  returnWindowDays     Int?
  replacementAllowed   Boolean       @default(true)
  assemblyRequired     Boolean       @default(false)
  installationRequired Boolean       @default(false)
  isFragile            Boolean       @default(false)
  isHeavy              Boolean       @default(false)
  shippingClass        ShippingClass @default(STANDARD)

  // Merchandising read model (derived; never authoritative for money)
  ratingAvg   Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int     @default(0)
  reviewCount Int     @default(0)
  soldCount   Int     @default(0)
  viewCount   Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  searchKeywords  String?
  searchVector    Unsupported("tsvector")?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  variants            ProductVariant[]
  images              ProductImage[]
  attributeValues     ProductAttributeValue[]
  specifications      ProductSpecification[]
  sponsoredPlacements SponsoredPlacement[]
  relationsFrom       ProductRelation[]       @relation("ProductRelationsFrom")
  relationsTo         ProductRelation[]       @relation("ProductRelationsTo")
  reviews             Review[]
  questions           ProductQuestion[]
  orderItems          OrderItem[]
  coupons             Coupon[]
  wishlistItems       WishlistItem[]
  promotionProducts   PromotionProduct[]

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, soldCount(sort: Desc)])
  @@index([status, ratingAvg(sort: Desc)])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  name        String
  barcode     String?
  price       Decimal  @db.Decimal(14, 2)
  mrp         Decimal  @db.Decimal(14, 2)
  costPrice   Decimal? @db.Decimal(14, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  weightGrams Int?
  lengthMm    Int?
  widthMm     Int?
  heightMm    Int?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images             ProductImage[]
  attributeValues    VariantAttributeValue[]
  priceHistory       ProductPriceHistory[]
  inventory          Inventory[]
  stockMovements     StockMovement[]
  reservations       StockReservation[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  comparisonItems    ComparisonItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  stockTransferItems StockTransferItem[]
  orderItems         OrderItem[]

  @@index([productId, isActive])
  @@index([price])
  @@index([isActive])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  variantId   String?
  url         String
  alt         String
  width       Int?
  height      Int?
  blurDataUrl String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
}

model AttributeDefinition {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  dataType      AttributeDataType @default(SELECT)
  unit          String?
  isVariantAxis Boolean           @default(false)
  isFilterable  Boolean           @default(true)
  isComparable  Boolean           @default(false)
  sortOrder     Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  options            AttributeOption[]
  categoryAttributes CategoryAttribute[]
  productValues      ProductAttributeValue[]
  variantValues      VariantAttributeValue[]

  @@index([isActive, sortOrder])
}

model AttributeOption {
  id          String  @id @default(cuid())
  attributeId String
  value       String
  label       String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  productValues ProductAttributeValue[]
  variantValues VariantAttributeValue[]

  @@unique([attributeId, value])
  @@index([attributeId, sortOrder])
}

model CategoryAttribute {
  categoryId   String
  attributeId  String
  isRequired   Boolean @default(false)
  isFilterable Boolean @default(true)
  sortOrder    Int     @default(0)

  category  Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([attributeId])
}

model ProductAttributeValue {
  id           String   @id @default(cuid())
  productId    String
  attributeId  String
  optionId     String?
  valueText    String?
  valueNumber  Decimal? @db.Decimal(14, 3)
  valueBoolean Boolean?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([productId, attributeId])
  @@index([attributeId, optionId])
}

model VariantAttributeValue {
  id          String   @id @default(cuid())
  variantId   String
  attributeId String
  optionId    String?
  valueText   String?
  valueNumber Decimal? @db.Decimal(14, 3)

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([variantId, attributeId])
  @@index([attributeId, optionId])
}

model ProductSpecification {
  id        String @id @default(cuid())
  productId String
  group     String
  label     String
  value     String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, group, sortOrder])
}

model ProductPriceHistory {
  id              String    @id @default(cuid())
  variantId       String
  price           Decimal   @db.Decimal(14, 2)
  mrp             Decimal   @db.Decimal(14, 2)
  effectiveFrom   DateTime  @default(now()) @db.Timestamptz(3)
  effectiveTo     DateTime? @db.Timestamptz(3)
  reason          String?
  changedByUserId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, effectiveFrom(sort: Desc)])
  @@index([effectiveFrom])
}

model SponsoredPlacement {
  id              String   @id @default(cuid())
  productId       String
  placement       String
  startsAt        DateTime @db.Timestamptz(3)
  endsAt          DateTime @db.Timestamptz(3)
  rank            Int      @default(0)
  disclosureLabel String   @default("Sponsored")
  budgetReference String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([placement, isActive, startsAt, endsAt])
  @@index([productId])
}

model ProductRelation {
  id               String              @id @default(cuid())
  productId        String
  relatedProductId String
  type             ProductRelationType @default(RELATED)
  sortOrder        Int                 @default(0)

  product        Product @relation("ProductRelationsFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("ProductRelationsTo", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId, type])
  @@index([relatedProductId])
}

model ProductQuestion {
  id        String         @id @default(cuid())
  productId String
  userId    String
  question  String
  status    QuestionStatus @default(PENDING)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ProductAnswer[]

  @@index([productId, status, createdAt(sort: Desc)])
}

model ProductAnswer {
  id         String         @id @default(cuid())
  questionId String
  userId     String
  answer     String
  isOfficial Boolean        @default(false)
  status     QuestionStatus @default(PENDING)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, status])
}

// ---------------------------------------------------------------------------
// Inventory & procurement
// ---------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   Json?
  city      String?
  state     String?
  pincode   String?
  gstin     String?
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  inventories         Inventory[]
  serviceablePincodes ServiceablePincode[]
  stockMovements      StockMovement[]
  reservations        StockReservation[]
  purchaseOrders      PurchaseOrder[]
  goodsReceipts       GoodsReceipt[]
  transfersFrom       StockTransfer[]      @relation("TransferFrom")
  transfersTo         StockTransfer[]      @relation("TransferTo")

  @@index([isActive, isDefault])
}

model ServiceablePincode {
  id                    String   @id @default(cuid())
  pincode               String
  warehouseId           String?
  city                  String?
  state                 String?
  codAvailable          Boolean  @default(true)
  standardDays          Int      @default(5)
  furnitureAvailable    Boolean  @default(false)
  installationAvailable Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@unique([pincode, warehouseId])
  @@index([pincode, isActive])
}

model Inventory {
  id                String   @id @default(cuid())
  variantId         String
  warehouseId       String
  onHand            Int      @default(0)
  reserved          Int      @default(0)
  damaged           Int      @default(0)
  returned          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
  @@index([variantId])
}

model StockReservation {
  id             String            @id @default(cuid())
  variantId      String
  warehouseId    String
  quantity       Int
  cartId         String?
  orderId        String?
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime          @db.Timestamptz(3)
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  cart      Cart?          @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order     Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([variantId, status])
  @@index([orderId])
}

model StockMovement {
  id            String            @id @default(cuid())
  variantId     String
  warehouseId   String
  type          StockMovementType
  quantity      Int
  onHandAfter   Int
  reservedAfter Int
  referenceType String?
  referenceId   String?
  reason        String?
  actorUserId   String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt(sort: Desc)])
  @@index([warehouseId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
}

model Supplier {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  contactName  String?
  email        String?
  phone        String?
  gstin        String?
  address      Json?
  paymentTerms String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  purchaseOrders PurchaseOrder[]

  @@index([isActive])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  warehouseId String
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?           @db.Timestamptz(3)
  subtotal    Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal    Decimal             @default(0) @db.Decimal(14, 2)
  total       Decimal             @default(0) @db.Decimal(14, 2)
  notes       String?
  createdBy   String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)

  supplier  Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     PurchaseOrderItem[]
  receipts  GoodsReceipt[]

  @@index([status, createdAt(sort: Desc)])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  variantId        String
  quantity         Int
  receivedQuantity Int     @default(0)
  unitCost         Decimal @db.Decimal(14, 2)
  taxRate          Decimal @default(0) @db.Decimal(5, 2)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems  GoodsReceiptItem[]

  @@unique([purchaseOrderId, variantId])
  @@index([variantId])
}

model GoodsReceipt {
  id              String   @id @default(cuid())
  receiptNumber   String   @unique
  purchaseOrderId String
  warehouseId     String
  receivedAt      DateTime @default(now()) @db.Timestamptz(3)
  receivedBy      String?
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([receivedAt])
}

model GoodsReceiptItem {
  id                  String  @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderItemId String
  variantId           String
  quantity            Int
  unitCost            Decimal @db.Decimal(14, 2)
  condition           String?

  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@index([variantId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  transferNumber  String         @unique
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  requestedBy     String?
  approvedBy      String?
  shippedAt       DateTime?      @db.Timestamptz(3)
  receivedAt      DateTime?      @db.Timestamptz(3)
  notes           String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items         StockTransferItem[]

  @@index([status, createdAt(sort: Desc)])
}

model StockTransferItem {
  id               String @id @default(cuid())
  stockTransferId  String
  variantId        String
  quantity         Int
  receivedQuantity Int    @default(0)

  stockTransfer StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([stockTransferId, variantId])
  @@index([variantId])
}

// ---------------------------------------------------------------------------
// Cart, wishlist, comparison, coupons, promotions, reviews
// ---------------------------------------------------------------------------

model Cart {
  id             String     @id @default(cuid())
  userId         String?
  guestTokenHash String?
  status         CartStatus @default(ACTIVE)
  couponId       String?
  currency       String     @default("INR") @db.Char(3)
  subtotal       Decimal    @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal    @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal    @default(0) @db.Decimal(14, 2)
  shippingTotal  Decimal    @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal    @default(0) @db.Decimal(14, 2)
  expiresAt      DateTime?  @db.Timestamptz(3)
  mergedIntoId   String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon       Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items        CartItem[]
  reservations StockReservation[]

  @@index([userId, status])
  @@index([guestTokenHash, status])
  @@index([status, updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String?
  variantId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model Comparison {
  id             String   @id @default(cuid())
  userId         String?
  guestTokenHash String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  user  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ComparisonItem[]

  @@index([userId])
  @@index([guestTokenHash])
}

model ComparisonItem {
  id           String   @id @default(cuid())
  comparisonId String
  variantId    String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  comparison Comparison     @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, variantId])
}

model Coupon {
  id               String      @id @default(cuid())
  code             String      @unique
  description      String?
  type             CouponType
  value            Decimal     @db.Decimal(14, 2)
  maxDiscount      Decimal?    @db.Decimal(14, 2)
  minOrderValue    Decimal?    @db.Decimal(14, 2)
  scope            CouponScope @default(ORDER)
  categoryId       String?
  productId        String?
  brandId          String?
  firstOrderOnly   Boolean     @default(false)
  startsAt         DateTime?   @db.Timestamptz(3)
  endsAt           DateTime?   @db.Timestamptz(3)
  totalUsageLimit  Int?
  perCustomerLimit Int?        @default(1)
  usedCount        Int         @default(0)
  stackable        Boolean     @default(false)
  isActive         Boolean     @default(true)
  createdBy        String?
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  brand    Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  usages CouponUsage[]
  carts  Cart[]
  orders Order[]

  @@index([isActive, startsAt, endsAt])
  @@index([categoryId])
  @@index([productId])
  @@index([brandId])
}

model CouponUsage {
  id             String   @id @default(cuid())
  couponId       String
  orderId        String   @unique
  userId         String?
  email          String?
  discountAmount Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId, createdAt])
  @@index([userId, couponId])
}

model Promotion {
  id        String        @id @default(cuid())
  name      String
  code      String?       @unique
  type      PromotionType
  value     Decimal       @db.Decimal(14, 2)
  startsAt  DateTime      @db.Timestamptz(3)
  endsAt    DateTime      @db.Timestamptz(3)
  priority  Int           @default(0)
  stackable Boolean       @default(false)
  isActive  Boolean       @default(true)
  config    Json?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  products   PromotionProduct[]
  categories PromotionCategory[]
  brands     PromotionBrand[]

  @@index([isActive, startsAt, endsAt, priority])
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String
  categoryId  String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

model PromotionBrand {
  promotionId String
  brandId     String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([promotionId, brandId])
  @@index([brandId])
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String
  orderItemId        String?      @unique
  rating             Int
  title              String?
  body               String
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  helpfulCount       Int          @default(0)
  adminNote          String?
  publishedAt        DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  images    ReviewImage[]
  votes     ReviewVote[]
  reports   ReviewReport[]

  @@index([productId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([rating])
}

model ReviewImage {
  id        String  @id @default(cuid())
  reviewId  String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  isHelpful Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
}

model ReviewReport {
  id         String             @id @default(cuid())
  reviewId   String
  reporterId String?
  reason     String
  status     ReviewReportStatus @default(OPEN)
  createdAt  DateTime           @default(now()) @db.Timestamptz(3)

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Orders, payments, invoices, shipping
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  sellerId      String
  email         String
  phone         String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  currency      String        @default("INR") @db.Char(3)

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal @default(0) @db.Decimal(14, 2)
  couponDiscount Decimal @default(0) @db.Decimal(14, 2)
  shippingTotal  Decimal @default(0) @db.Decimal(14, 2)
  codFee         Decimal @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal @default(0) @db.Decimal(14, 2)
  grandTotal     Decimal @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal @default(0) @db.Decimal(14, 2)
  amountRefunded Decimal @default(0) @db.Decimal(14, 2)

  couponId                String?
  couponCode              String?
  customerSnapshot        Json
  shippingAddressSnapshot Json
  billingAddressSnapshot  Json?
  sellerSnapshot          Json?

  placeOfSupplyState    String?
  sellerState           String?
  isInterState          Boolean      @default(false)
  shippingMethod        String?
  deliveryType          DeliveryType @default(STANDARD)
  expectedDeliveryDate  DateTime?    @db.Date
  installationRequested Boolean      @default(false)
  installationCharge    Decimal      @default(0) @db.Decimal(14, 2)
  customerNote          String?
  adminNote             String?
  ipAddress             String?
  userAgent             String?
  source                String       @default("WEB")
  termsVersion          String?
  cancelledAt           DateTime?    @db.Timestamptz(3)
  deliveredAt           DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  seller Seller  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  notes              OrderNote[]
  payments           Payment[]
  refunds            Refund[]
  shipments          Shipment[]
  returns            ReturnRequest[]      @relation("OrderReturns")
  replacementReturns ReturnRequest[]      @relation("ReplacementOrder")
  invoice            Invoice?
  couponUsages       CouponUsage[]
  stockReservations  StockReservation[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?
  productName       String
  variantName       String
  sku               String
  hsnCode           String?
  imageUrl          String?
  quantity          Int
  unitPrice         Decimal         @db.Decimal(14, 2)
  unitMrp           Decimal         @db.Decimal(14, 2)
  discountAmount    Decimal         @default(0) @db.Decimal(14, 2)
  taxableValue      Decimal         @db.Decimal(14, 2)
  taxRate           Decimal         @db.Decimal(5, 2)
  cgst              Decimal         @default(0) @db.Decimal(14, 2)
  sgst              Decimal         @default(0) @db.Decimal(14, 2)
  igst              Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal         @db.Decimal(14, 2)
  status            OrderItemStatus @default(ACTIVE)
  cancelledQuantity Int             @default(0)
  returnedQuantity  Int             @default(0)
  refundedAmount    Decimal         @default(0) @db.Decimal(14, 2)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  returnItems   ReturnItem[]
  shipmentItems ShipmentItem[]
  review        Review?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  note            String?
  changedByUserId String?
  metadata        Json?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

model OrderNote {
  id                String   @id @default(cuid())
  orderId           String
  authorId          String?
  body              String
  isCustomerVisible Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("INR") @db.Char(3)
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  idempotencyKey    String        @unique
  capturedAt        DateTime?     @db.Timestamptz(3)
  failureCode       String?
  failureMessage    String?
  rawSummary        Json?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([orderId])
  @@index([status, createdAt])
}

model PaymentTransaction {
  id                String                 @id @default(cuid())
  paymentId         String
  type              PaymentTransactionType
  amount            Decimal                @db.Decimal(14, 2)
  providerReference String?
  payloadHash       String?
  signatureVerified Boolean                @default(false)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([providerReference])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  lastError   String?
  receivedAt  DateTime      @default(now()) @db.Timestamptz(3)
  processedAt DateTime?     @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([provider, eventType])
}

model Refund {
  id               String       @id @default(cuid())
  refundNumber     String       @unique
  orderId          String
  paymentId        String
  returnRequestId  String?
  amount           Decimal      @db.Decimal(14, 2)
  reason           String
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?      @unique
  idempotencyKey   String       @unique
  initiatedBy      String?
  approvedBy       String?
  processedAt      DateTime?    @db.Timestamptz(3)
  failureReason    String?
  notes            String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([paymentId])
  @@index([status, createdAt])
}

model Shipment {
  id                  String             @id @default(cuid())
  orderId             String
  provider            String
  providerShipmentId  String?
  awb                 String?
  status              ShipmentStatus     @default(PENDING)
  trackingUrl         String?
  labelUrl            String?
  pickupScheduledAt   DateTime?          @db.Timestamptz(3)
  dispatchedAt        DateTime?          @db.Timestamptz(3)
  deliveredAt         DateTime?          @db.Timestamptz(3)
  estimatedDeliveryAt DateTime?          @db.Timestamptz(3)
  deliveryType        DeliveryType       @default(STANDARD)
  installationStatus  InstallationStatus @default(NOT_REQUIRED)
  failureReason       String?
  isReturnShipment    Boolean            @default(false)
  returnRequestId     String?
  weightGrams         Int?
  lengthMm            Int?
  widthMm             Int?
  heightMm            Int?
  shippingCharges     Decimal            @default(0) @db.Decimal(14, 2)
  metadata            Json?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  items    ShipmentItem[]
  tracking ShipmentTracking[]

  @@index([orderId])
  @@index([awb])
  @@index([status, estimatedDeliveryAt])
}

model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model ShipmentTracking {
  id          String         @id @default(cuid())
  shipmentId  String
  status      ShipmentStatus
  location    String?
  description String?
  occurredAt  DateTime       @db.Timestamptz(3)
  raw         Json?
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model Invoice {
  id            String    @id @default(cuid())
  orderId       String    @unique
  invoiceNumber String    @unique
  financialYear String
  invoiceDate   DateTime  @db.Timestamptz(3)
  placeOfSupply String?
  sellerGstin   String?
  buyerGstin    String?
  taxableValue  Decimal   @db.Decimal(14, 2)
  cgst          Decimal   @default(0) @db.Decimal(14, 2)
  sgst          Decimal   @default(0) @db.Decimal(14, 2)
  igst          Decimal   @default(0) @db.Decimal(14, 2)
  roundOff      Decimal   @default(0) @db.Decimal(14, 2)
  total         Decimal   @db.Decimal(14, 2)
  pdfUrl        String?
  irn           String?
  ackNumber     String?
  ackDate       DateTime? @db.Timestamptz(3)
  qrCodeData    String?
  status        String    @default("ISSUED")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([financialYear, invoiceDate])
}

model InvoiceSequence {
  id            String   @id @default(cuid())
  financialYear String
  documentType  String   @default("INVOICE")
  nextNumber    Int      @default(1)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  @@unique([financialYear, documentType])
}

// ---------------------------------------------------------------------------
// Returns, support, grievance
// ---------------------------------------------------------------------------

model ReturnRequest {
  id                    String            @id @default(cuid())
  returnNumber          String            @unique
  type                  ReturnType        @default(RETURN)
  orderId               String
  userId                String?
  replacementOrderId    String?
  status                ReturnStatus      @default(REQUESTED)
  resolution            ReturnResolution?
  reason                ReturnReason
  description           String?
  customerImages        Json?
  pickupAddressSnapshot Json?
  policySnapshot        Json?
  requestedAt           DateTime          @default(now()) @db.Timestamptz(3)
  slaDueAt              DateTime?         @db.Timestamptz(3)
  approvedAt            DateTime?         @db.Timestamptz(3)
  rejectedAt            DateTime?         @db.Timestamptz(3)
  rejectionReason       String?
  inspectionNotes       String?
  inspectedBy           String?
  nchReference          String?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  order            Order  @relation("OrderReturns", fields: [orderId], references: [id], onDelete: Cascade)
  user             User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  replacementOrder Order? @relation("ReplacementOrder", fields: [replacementOrderId], references: [id], onDelete: SetNull)

  items     ReturnItem[]
  history   ReturnStatusHistory[]
  refunds   Refund[]
  shipments Shipment[]

  @@index([orderId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, slaDueAt])
}

model ReturnItem {
  id               String              @id @default(cuid())
  returnRequestId  String
  orderItemId      String
  quantity         Int
  condition        ReturnItemCondition
  reason           ReturnReason?
  images           Json?
  approvedQuantity Int                 @default(0)
  restockStatus    RestockStatus       @default(PENDING)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model ReturnStatusHistory {
  id              String        @id @default(cuid())
  returnRequestId String
  fromStatus      ReturnStatus?
  toStatus        ReturnStatus
  note            String?
  actorId         String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId, createdAt])
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  userId          String?
  orderId         String?
  name            String
  email           String
  phone           String?
  category        TicketCategory
  subject         String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  assignedToId    String?
  slaAckDueAt     DateTime?      @db.Timestamptz(3)
  slaResolveDueAt DateTime?      @db.Timestamptz(3)
  acknowledgedAt  DateTime?      @db.Timestamptz(3)
  resolvedAt      DateTime?      @db.Timestamptz(3)
  metadata        Json?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status, slaAckDueAt])
  @@index([status, slaResolveDueAt])
  @@index([email])
  @@index([userId, createdAt(sort: Desc)])
}

model SupportMessage {
  id          String           @id @default(cuid())
  ticketId    String
  senderType  TicketSenderType
  senderId    String?
  body        String
  attachments Json?
  isInternal  Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Grievance {
  id              String          @id @default(cuid())
  grievanceNumber String          @unique
  userId          String?
  name            String
  email           String
  phone           String?
  orderId         String?
  category        String
  description     String
  status          GrievanceStatus @default(RECEIVED)
  acknowledgedAt  DateTime?       @db.Timestamptz(3)
  resolvedAt      DateTime?       @db.Timestamptz(3)
  resolution      String?
  assignedToId    String?
  statutoryDueAt  DateTime        @db.Timestamptz(3)
  copySentAt      DateTime?       @db.Timestamptz(3)
  nchReference    String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, statutoryDueAt])
  @@index([email])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Legal, consent, privacy, compliance
// ---------------------------------------------------------------------------

model LegalDocument {
  id              String            @id @default(cuid())
  slug            String            @unique
  type            LegalDocumentType @default(OTHER)
  title           String
  isActive        Boolean           @default(true)
  requiresConsent Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  versions LegalDocumentVersion[]

  @@index([type, isActive])
}

model LegalDocumentVersion {
  id                   String            @id @default(cuid())
  documentId           String
  version              String
  content              String            @db.Text
  changeSummary        String?
  effectiveAt          DateTime          @db.Timestamptz(3)
  publishedAt          DateTime?         @db.Timestamptz(3)
  status               LegalDocStatus    @default(DRAFT)
  requiresReacceptance Boolean           @default(false)
  legalReviewStatus    LegalReviewStatus @default(NOT_REVIEWED)
  legalReviewedBy      String?
  legalReviewedAt      DateTime?         @db.Timestamptz(3)
  contentHash          String
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  document       LegalDocument          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  acceptances    UserPolicyAcceptance[]
  consentRecords ConsentRecord[]

  @@unique([documentId, version])
  @@index([status, effectiveAt])
  @@index([documentId, publishedAt(sort: Desc)])
}

model UserPolicyAcceptance {
  id         String   @id @default(cuid())
  userId     String
  versionId  String
  acceptedAt DateTime @default(now()) @db.Timestamptz(3)
  ip         String?
  userAgent  String?

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  version LegalDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([userId, versionId])
  @@index([versionId])
}

model ConsentRecord {
  id              String         @id @default(cuid())
  userId          String?
  anonId          String?
  purpose         ConsentPurpose
  granted         Boolean
  policyVersionId String?
  ip              String?
  userAgent       String?
  evidence        Json?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  withdrawnAt     DateTime?      @db.Timestamptz(3)

  user          User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  policyVersion LegalDocumentVersion? @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, createdAt(sort: Desc)])
  @@index([anonId, createdAt(sort: Desc)])
  @@index([purpose, createdAt(sort: Desc)])
}

model PrivacyRequest {
  id            String               @id @default(cuid())
  requestNumber String               @unique
  userId        String?
  email         String
  type          PrivacyRequestType
  status        PrivacyRequestStatus @default(RECEIVED)
  details       String?              @db.Text
  verifiedAt    DateTime?            @db.Timestamptz(3)
  dueAt         DateTime             @db.Timestamptz(3)
  completedAt   DateTime?            @db.Timestamptz(3)
  responseUrl   String?
  notes         String?              @db.Text
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([email, createdAt(sort: Desc)])
}

model ComplianceAudit {
  id                    String                @id @default(cuid())
  type                  ComplianceAuditType
  periodStart           DateTime              @db.Date
  periodEnd             DateTime              @db.Date
  performedAt           DateTime?             @db.Timestamptz(3)
  performedBy           String?
  findings              Json?
  certificateUrl        String?
  certificateValidUntil DateTime?             @db.Date
  status                ComplianceAuditStatus @default(PLANNED)
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)

  @@index([type, periodStart(sort: Desc)])
  @@index([status, certificateValidUntil])
}

