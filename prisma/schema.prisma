// CasaCircuit — PostgreSQL schema
// Prisma 7.10.x / PostgreSQL 18
//
// Conventions:
// - cuid() identifiers everywhere
// - Decimal(14,2) for money, Decimal(5,2) for tax rates
// - timestamptz(3) timestamps
// - append-only: price history, stock movements, payments, audit logs
// - order/invoice data is snapshotted; product edits never rewrite history

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

