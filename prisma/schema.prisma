  slug           String     @unique
  title          String
  excerpt        String?
  content        String     @db.Text
  coverImageUrl  String?
  authorId       String?
  status         BlogStatus @default(DRAFT)
  publishedAt    DateTime?  @db.Timestamptz(3)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([status, publishedAt(sort: Desc)])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([category, sortOrder])
  @@index([isActive])
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   Json
  phone     String?
  email     String?
  hours     Json?
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  userId         String?   @unique
  status         String    @default("SUBSCRIBED")
  consentAt      DateTime  @default(now()) @db.Timestamptz(3)
  source         String?
  unsubscribedAt DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// Operations: settings, audit, outbox, idempotency, notifications, logs
// ---------------------------------------------------------------------------

model AppSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String   @default("USER")
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt])
}

model OutboxEvent {
  id            String       @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @db.Timestamptz(3)
  dispatchedAt  DateTime?    @db.Timestamptz(3)
  lastError     String?      @db.Text
  dedupeKey     String?      @unique
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
}

model IdempotencyKey {
  id           String            @id @default(cuid())
  scope        String
  key          String
  requestHash  String
  status       IdempotencyStatus @default(IN_PROGRESS)
  statusCode   Int?
  responseJson Json?
  expiresAt    DateTime          @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  template  String
  payload   Json
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?           @db.Timestamptz(3)
  readAt    DateTime?           @db.Timestamptz(3)
  dedupeKey String?             @unique
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([channel, status, createdAt])
}

model EmailLog {
  id                String    @id @default(cuid())
  recipient         String
  template          String
  provider          String
  providerMessageId String?
  status            String    @default("QUEUED")
  error             String?   @db.Text
  attempts          Int       @default(0)
  sentAt            DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([recipient, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model SmsLog {
  id                String    @id @default(cuid())
  recipient         String
  template          String
  provider          String
  providerMessageId String?
  status            String    @default("QUEUED")
  error             String?   @db.Text
  attempts          Int       @default(0)
  sentAt            DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([recipient, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model AnalyticsDaily {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  metrics   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
